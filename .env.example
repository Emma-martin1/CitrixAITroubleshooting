# Copy to .env and fill in your own values. .env is git-ignored.
# Authentication uses Microsoft Entra ID (DefaultAzureCredential, e.g. `az login`) — no API key needed.

# Foundry project endpoint (Foundry portal → project → Overview)
AZURE_AI_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Classifier agent (created in the Foundry portal)
AZURE_AI_AGENT_NAME=<classifier-agent-name>
AZURE_AI_AGENT_VERSION=1

# RAG solution agent (created by scripts/create_solution_agent.py, which prints the version)
AZURE_AI_SOLUTION_AGENT_NAME=citrix-solution-agent
AZURE_AI_SOLUTION_AGENT_VERSION=1
